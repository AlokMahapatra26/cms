# EdgeCMS Frontend Environment Variables (Layer 2: Server-Side Concealment)
# 
# IMPORTANT: In Next.js and Astro, do NOT prefix CMS_API_SECRET_KEY with NEXT_PUBLIC_ or PUBLIC_.
# Keeping it un-prefixed ensures it runs strictly in Server Components / SSR / Route Handlers,
# completely concealing your API URL and Secret Key from the browser's F12 Network Tab.

CMS_API_URL=http://localhost:8787
CMS_API_SECRET_KEY=cf_live_default_key
CMS_WORKSPACE_SLUG=default

