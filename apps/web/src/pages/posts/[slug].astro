---
import Layout from '../../layouts/Layout.astro';
import { marked } from 'marked';
import type { Post } from '@cms/shared';

export async function getStaticPaths() {
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  try {
    const res = await fetch(`${API_BASE}/api/posts`);
    if (!res.ok) return [];
    const posts: Post[] = await res.json();
    return posts.map((post) => ({
      params: { slug: post.slug }
    }));
  } catch (err) {
    return [];
  }
}

const { slug } = Astro.params;
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
let post: Post | null = null;

try {
  const res = await fetch(`${API_BASE}/api/posts/${slug}`);
  if (res.ok) {
    post = await res.json();
  }
} catch (e) {
  // handled in template
}

const htmlContent = post ? await marked.parse(post.content || '') : '';
---

<Layout title={post ? `${post.title} — EdgeStorefront` : 'Article Not Found'}>
  <div style="margin-bottom: 24px;">
    <a href="/" class="btn-outline-pill" style="font-size: 13px; padding: 6px 16px;">
      &larr; Back to articles
    </a>
  </div>

  {!post ? (
    <div style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 64px 24px; text-align: center;">
      <h2 style="font-size: 22px; font-weight: 600; margin: 0 0 8px 0;">Article Not Found</h2>
      <p style="color: #71717a; margin: 0;">The article "<code>{slug}</code>" could not be found or is not published yet.</p>
    </div>
  ) : (
    <article style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 16px; padding: 40px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);">
      <header style="margin-bottom: 28px;">
        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
          <span class="pill-tag-mint">Published</span>
          <span style="font-size: 13px; color: #71717a;">
            {new Date(post.created_at).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' })}
          </span>
        </div>
        <h1 style="font-size: 36px; font-weight: 500; color: #000000; margin: 0; line-height: 1.2; letter-spacing: -0.01em;">
          {post.title}
        </h1>
      </header>

      {post.cover_image && (
        <div style="margin: 28px 0; border-radius: 12px; overflow: hidden; border: 1px solid #e4e4e7; background-color: #f4f4f5;">
          <img
            src={post.cover_image}
            alt={post.title}
            style="width: 100%; max-height: 480px; object-fit: cover; display: block;"
          />
        </div>
      )}

      {post.excerpt && (
        <div style="margin: 20px 0 28px 0; padding: 18px 24px; background-color: #fbfbf5; border: 1px solid #e4e4e7; border-radius: 12px; font-size: 16px; color: #3f3f46; line-height: 1.5;">
          {post.excerpt}
        </div>
      )}

      <div
        class="prose-content"
        style="line-height: 1.7; font-size: 16px; color: #000000;"
        set:html={htmlContent}
      />
    </article>
  )}
</Layout>

<style is:global>
  .prose-content h1,
  .prose-content h2,
  .prose-content h3 {
    font-weight: 600;
    color: #000000;
    letter-spacing: -0.01em;
    margin-top: 36px;
    margin-bottom: 14px;
  }
  .prose-content p {
    margin: 16px 0;
  }
  .prose-content code {
    background-color: #f4f4f5;
    padding: 3px 7px;
    border-radius: 6px;
    font-size: 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .prose-content pre {
    background-color: #000000;
    color: #f4f4f5;
    padding: 20px;
    border-radius: 12px;
    overflow-x: auto;
  }
  .prose-content pre code {
    background-color: transparent;
    padding: 0;
    color: inherit;
  }
  .prose-content img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 24px 0;
    border: 1px solid #e4e4e7;
    display: block;
  }
  .prose-content blockquote {
    border-left: 4px solid #c1fbd4;
    padding: 8px 18px;
    margin: 24px 0;
    font-style: italic;
    color: #52525b;
    background-color: #fbfbf5;
    border-radius: 0 8px 8px 0;
  }
  .prose-content ul,
  .prose-content ol {
    padding-left: 28px;
    margin: 16px 0;
  }
  .prose-content li {
    margin-bottom: 6px;
  }
  .prose-content hr {
    border: none;
    border-top: 1px solid #e4e4e7;
    margin: 32px 0;
  }
  .prose-content a {
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
</style>
