---
import Layout from '../../layouts/Layout.astro';
import { marked } from 'marked';
import type { Post } from '@cms/shared';

export async function getStaticPaths() {
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  try {
    const res = await fetch(`${API_BASE}/api/posts`);
    if (!res.ok) return [];
    const posts: Post[] = await res.json();
    const paths = [];
    for (const post of posts) {
      if (!post.slug) continue;
      paths.push({ params: { slug: post.slug } });
      const encoded = encodeURIComponent(post.slug);
      if (encoded !== post.slug) {
        paths.push({ params: { slug: encoded } });
      }
    }
    return paths;
  } catch (err) {
    return [];
  }
}

const rawSlug = Astro.params.slug;
const slug = decodeURIComponent(rawSlug || '');
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
let post: Post | null = null;

try {
  const safeSlug = encodeURIComponent(slug || '');
  const res = await fetch(`${API_BASE}/api/posts/${safeSlug}`);
  if (res.ok) {
    post = await res.json();
  }
} catch (e) {
  // handled in template
}

const htmlContent = post ? await marked.parse(post.content || '') : '';

const pageTitle = post
  ? (post.meta_title ? post.meta_title : `${post.title} — EdgeStorefront`)
  : 'Article Not Found';
const pageDescription = post
  ? (post.meta_description || post.excerpt || 'Read this article on EdgeStorefront.')
  : 'The requested article could not be found.';
const pageImage = post
  ? (post.og_image || post.cover_image || undefined)
  : undefined;
const canonicalUrl = post?.canonical_url || undefined;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={pageImage}
  canonicalUrl={canonicalUrl}
  type="article"
  publishedTime={post?.created_at}
>
  <div style="margin-bottom: 24px;">
    <a href="/" class="btn-ghost">
      &larr; Back to articles
    </a>
  </div>

  {!post ? (
    <div style="background-color: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 64px 24px; text-align: center;">
      <h2 style="font-size: 20px; font-weight: 600; margin: 0 0 8px 0; color: var(--color-ink);">Article Not Found</h2>
      <p style="color: var(--color-mute); margin: 0; font-size: 14px;">The article "<code>{slug}</code>" could not be found or is not published yet.</p>
    </div>
  ) : (
    <article style="background-color: var(--color-canvas-elevated); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 40px; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
      <header style="margin-bottom: 28px;">
        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
          <span class="badge-published">PUBLISHED</span>
          <span style="font-size: 12px; color: var(--color-mute); font-family: var(--font-mono);">
            {new Date(post.created_at).toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' })}
          </span>
        </div>
        <h1 style="font-size: 32px; font-weight: 600; color: var(--color-ink); margin: 0; line-height: 1.25; letter-spacing: -1.28px;">
          {post.title}
        </h1>
      </header>

      {post.cover_image && (
        <div style="margin: 28px 0; border-radius: 6px; overflow: hidden; border: 1px solid var(--color-hairline); background-color: var(--color-hairline-soft);">
          <img
            src={post.cover_image}
            alt={post.title}
            style="width: 100%; max-height: 480px; object-fit: cover; display: block;"
          />
        </div>
      )}

      {post.excerpt && (
        <div style="margin: 20px 0 28px 0; padding: 16px 20px; background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: 6px; font-size: 15px; color: var(--color-body); line-height: 1.5;">
          {post.excerpt}
        </div>
      )}

      <div
        class="prose-content"
        style="line-height: 1.7; font-size: 15px; color: var(--color-body);"
        set:html={htmlContent}
      />
    </article>
  )}
</Layout>

<style is:global>
  .prose-content h1,
  .prose-content h2,
  .prose-content h3 {
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.4px;
    margin-top: 36px;
    margin-bottom: 14px;
  }
  .prose-content p {
    margin: 16px 0;
  }
  .prose-content code {
    background-color: var(--color-hairline-soft);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
    font-family: var(--font-mono);
  }
  .prose-content pre {
    background-color: #171717;
    color: #f4f4f5;
    padding: 16px 20px;
    border-radius: 6px;
    border: 1px solid #333333;
    overflow-x: auto;
  }
  .prose-content pre code {
    background-color: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }
  .prose-content img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 24px 0;
    border: 1px solid var(--color-hairline);
    display: block;
  }
  .prose-content blockquote {
    border-left: 2px solid var(--color-ink);
    padding: 8px 18px;
    margin: 24px 0;
    color: var(--color-body);
    background-color: var(--color-canvas);
    border-radius: 0 4px 4px 0;
  }
  .prose-content ul,
  .prose-content ol {
    padding-left: 28px;
    margin: 16px 0;
  }
  .prose-content li {
    margin-bottom: 6px;
  }
  .prose-content hr {
    border: none;
    border-top: 1px solid #e4e4e7;
    margin: 32px 0;
  }
  .prose-content a {
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
</style>
