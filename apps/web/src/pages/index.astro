---
import Layout from '../layouts/Layout.astro';
import { getCMSContent } from '../lib/cms';

const posts = await getCMSContent('blogs');
---

<Layout title="EdgeCMS — Blank Canvas">
  <div class="site-container">
    <header class="site-header">
      <div class="site-tag">Fullstack Edge Website</div>
      <h1 class="site-title">Minimalist Canvas</h1>
      <p class="site-desc">
        Connected directly to your local EdgeCMS D1 database. Content updates in Studio are reflected here instantly.
      </p>
    </header>

    <main class="posts-list">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">No published content found</p>
          <p class="empty-desc">Create collections and publish articles in EdgeCMS Studio to render them here.</p>
        </div>
      ) : (
        posts.map((post) => {
          const title = post.data?.title || post.data?.name || 'Untitled Article';
          const description = post.data?.description || '';
          const author = post.data?.auther;
          const authorName = typeof author === 'object' && author ? author.title : (typeof author === 'string' ? author : null);
          const authorAvatar = typeof author === 'object' && author?.profile ? author.profile : null;
          const thumbnail = post.data?.thumbnail;
          const date = post.data?.published || post.created_at;

          return (
            <article class="post-card">
              <a href={`/blogs/${post.id}`} class="post-link">
                {thumbnail && (
                  <div class="thumbnail-wrap">
                    <img src={thumbnail} alt={title} class="thumbnail-img" loading="lazy" />
                  </div>
                )}
                
                <div class="post-content">
                  <h2 class="post-title">{title}</h2>
                  {description && <p class="post-summary">{description}</p>}

                  <div class="post-meta">
                    {authorName && (
                      <span class="author-tag">
                        {authorAvatar && <img src={authorAvatar} alt={authorName} class="author-avatar" />}
                        <span>{authorName}</span>
                      </span>
                    )}
                    {authorName && <span class="meta-sep">•</span>}
                    <time class="meta-date">{new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                  </div>
                </div>
              </a>
            </article>
          );
        })
      )}
    </main>
  </div>
</Layout>

<style>
  .site-container {
    max-width: 680px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .site-header {
    margin-bottom: 44px;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 28px;
  }

  .site-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    color: #a1a1aa;
    background-color: #121212;
    border: 1px solid #27272a;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .site-title {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .site-desc {
    color: #888888;
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .post-card {
    border: 1px solid #1c1c1c;
    background-color: #0a0a0a;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.15s ease;
  }

  .post-card:hover {
    border-color: #333333;
    background-color: #0e0e0e;
    transform: translateY(-1px);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .thumbnail-wrap {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background-color: #121212;
    border-bottom: 1px solid #1c1c1c;
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }

  .post-card:hover .thumbnail-img {
    transform: scale(1.02);
  }

  .post-content {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-title {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .post-card:hover .post-title {
    color: #ffffff;
  }

  .post-summary {
    font-size: 13.5px;
    color: #999999;
    line-height: 1.55;
    margin: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #666666;
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid #161616;
  }

  .author-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #d1d5db;
    font-weight: 500;
  }

  .author-avatar {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #27272a;
  }

  .meta-sep {
    color: #3f3f46;
  }

  .meta-date {
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    color: #71717a;
  }

  .empty-state {
    padding: 60px 20px;
    text-align: center;
    background-color: #0a0a0a;
    border: 1px dashed #222222;
    border-radius: 12px;
  }

  .empty-title {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .empty-desc {
    font-size: 13px;
    color: #666666;
    margin: 0;
  }
</style>
