---
import Layout from '../layouts/Layout.astro';
import BlogTemplate from '../components/templates/BlogTemplate.astro';
import EcommerceTemplate from '../components/templates/EcommerceTemplate.astro';
import SaasTemplate from '../components/templates/SaasTemplate.astro';
import AgencyTemplate from '../components/templates/AgencyTemplate.astro';
import LocalBusinessTemplate from '../components/templates/LocalBusinessTemplate.astro';

// Read query parameter if in SSR mode, or default to 'blog'
const templateParam = Astro.url.searchParams.get('t') as any;
const active = ['blog', 'ecommerce', 'saas', 'agency', 'local'].includes(templateParam)
  ? templateParam
  : 'blog';

const titles: Record<string, string> = {
  blog: 'Tech & Architecture Journal',
  ecommerce: 'Aero Store — Minimalist Essentials',
  saas: 'EdgeCMS Cloud — The Modern Content Engine',
  agency: 'Apex Studio — Autonomous Creative Engineering',
  local: 'Aura Dental & Wellness Clinic'
};
---

<Layout title={titles[active]} activeTemplate={active}>
  {active === 'blog' && <BlogTemplate />}
  {active === 'ecommerce' && <EcommerceTemplate />}
  {active === 'saas' && <SaasTemplate />}
  {active === 'agency' && <AgencyTemplate />}
  {active === 'local' && <LocalBusinessTemplate />}
</Layout>
