---
import Layout from '../layouts/Layout.astro';
import { getCMSContent } from '../lib/cms';

const posts = await getCMSContent('blogs');
---

<Layout title="My Website">
  <div class="site-container">
    <header class="site-header">
      <h1 class="site-title">My Website</h1>
      <p class="site-desc">Powered by EdgeCMS & Astro</p>
    </header>

    <main class="posts-list">
      {posts.length === 0 ? (
        <p class="empty-state">No published items found. Create and publish content in EdgeCMS Studio.</p>
      ) : (
        posts.map((post) => (
          <article class="post-item">
            <h2 class="post-title">{post.data?.title || post.data?.name || 'Untitled'}</h2>
            <div class="post-meta">{new Date(post.created_at).toLocaleDateString()}</div>
            {post.data?.description && <p class="post-body">{post.data.description}</p>}
          </article>
        ))
      )}
    </main>
  </div>
</Layout>

<style>
  .site-container {
    max-width: 640px;
    margin: 80px auto;
    padding: 0 20px;
  }

  .site-header {
    margin-bottom: 40px;
    border-bottom: 1px solid #222;
    padding-bottom: 20px;
  }

  .site-title {
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }

  .site-desc {
    color: #777;
    font-size: 13px;
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .post-title {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }

  .post-meta {
    font-size: 11.5px;
    color: #666;
    font-family: var(--font-mono, monospace);
  }

  .post-body {
    font-size: 13.5px;
    color: #a1a1aa;
    line-height: 1.6;
    margin: 4px 0 0;
  }

  .empty-state {
    color: #666;
    font-size: 13px;
  }
</style>
