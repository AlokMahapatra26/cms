---
import Layout from '../layouts/Layout.astro';
import { getCMSContent } from '../lib/cms';

// Fetch live published items from EdgeCMS (e.g. 'blogs' or 'articles')
const items = await getCMSContent('blogs');
---

<Layout title="EdgeCMS — Developer Canvas">
  <div class="container canvas-wrapper">
    <!-- Hero / Canvas Intro -->
    <section class="canvas-hero">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="badge badge-emerald">Ready for Development</span>
        <span class="text-xs text-muted">Astro 5.0 + Cloudflare D1</span>
      </div>
      <h1 class="canvas-title">Blank Developer Canvas</h1>
      <p class="canvas-subtitle">
        Your frontend is connected to EdgeCMS. Edit <code>apps/web/src/pages/index.astro</code> to build your custom client website, blog, or store.
      </p>

      <div class="flex items-center gap-3 mt-6">
        <a href="http://localhost:5173" target="_blank" class="btn btn-primary">
          Open CMS Studio →
        </a>
        <a href="http://localhost:8787/api/posts" target="_blank" class="btn btn-secondary">
          Raw REST API
        </a>
      </div>
    </section>

    <!-- Quick How-To Snippet -->
    <section class="mt-8 mb-8">
      <div class="card p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-semibold text-white">How to fetch content in any Astro component:</span>
          <span class="text-2xs text-muted font-mono">src/lib/cms.ts</span>
        </div>
        <pre class="code-block"><code><span class="code-kw">import</span> &#123; getCMSContent &#125; <span class="code-kw">from</span> <span class="code-str">'../lib/cms'</span>;

<span class="code-comment">// Fetch any collection by slug ('blogs', 'products', 'services', etc.)</span>
<span class="code-kw">const</span> items = <span class="code-kw">await</span> getCMSContent(<span class="code-str">'blogs'</span>);</code></pre>
      </div>
    </section>

    <!-- Live Content from CMS -->
    <section class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-lg font-bold text-white mb-1">Live CMS Content</h2>
          <p class="text-xs text-secondary m-0">Synchronized directly from your Cloudflare D1 database.</p>
        </div>
        <span class="badge badge-cyan">{items.length} Items Found</span>
      </div>

      {items.length === 0 ? (
        <div class="card empty-card text-center py-10">
          <div class="text-sm font-semibold text-white mb-1">No published content found</div>
          <p class="text-xs text-muted max-w-md m-0 mx-auto mb-4">
            Go to EdgeCMS Studio to create a collection and publish your first entry. It will immediately show up here.
          </p>
          <a href="http://localhost:5173/schemas" target="_blank" class="btn btn-secondary btn-sm">
            Create Collection in Studio
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-2 gap-4">
          {items.map((item) => (
            <div class="card card-hover p-4 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="badge badge-emerald">{item.status}</span>
                  <span class="text-2xs text-muted font-mono">{item.id.slice(0, 8)}...</span>
                </div>
                <h3 class="text-base font-semibold text-white mb-1">
                  {item.data?.title || item.data?.name || 'Untitled Entry'}
                </h3>
                <p class="text-xs text-secondary line-clamp-2 m-0">
                  {item.data?.description || item.data?.excerpt || JSON.stringify(item.data)}
                </p>
              </div>

              <div class="flex items-center justify-between pt-3 mt-3 border-t border-hairline text-2xs text-muted font-mono">
                <span>collection: {item.collection_slug}</span>
                <span>{new Date(item.created_at).toLocaleDateString()}</span>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>

<style>
  .canvas-wrapper {
    max-width: 900px;
    margin: 48px auto;
  }

  .canvas-title {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .canvas-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 620px;
  }

  .canvas-subtitle code {
    background: var(--bg-hover);
    color: var(--text-primary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .code-block {
    background: #000000;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: #e4e4e7;
    margin: 0;
  }

  .code-kw { color: #38bdf8; }
  .code-str { color: #a3e635; }
  .code-comment { color: #71717a; font-style: italic; }

  .empty-card {
    border-style: dashed;
    background: transparent;
  }

  .p-4 { padding: 16px; }
  .p-5 { padding: 20px; }
  .mt-8 { margin-top: 32px; }
  .mb-8 { margin-bottom: 32px; }
  .text-2xs { font-size: 11px; }
  .border-hairline { border-color: var(--border-hairline); }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
