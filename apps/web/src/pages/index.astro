---
import Layout from '../layouts/Layout.astro';
import type { Post } from '@cms/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

let posts: Post[] = [];
let fetchError = null;

try {
  const res = await fetch(`${API_BASE}/api/posts`);
  if (res.ok) {
    posts = await res.json();
  } else {
    fetchError = `API error: ${res.status} ${res.statusText}`;
  }
} catch (e: any) {
  fetchError = `Failed to connect to API worker at ${API_BASE}.`;
}
---

<Layout title="EdgeStorefront — Powered by Cloudflare D1 & R2">
  <div style="margin-bottom: 36px;">
    <h1 style="font-size: 38px; font-weight: 400; color: #000000; margin: 0 0 8px 0; letter-spacing: -0.01em;">
      Publications
    </h1>
    <p style="font-size: 16px; color: #71717a; margin: 0; font-weight: 400;">
      Articles and updates distributed worldwide with sub-50ms latency from Cloudflare edge.
    </p>
  </div>

  {fetchError && (
    <div style="padding: 16px 20px; border-radius: 12px; background-color: #fef2f2; border: 1px solid #fee2e2; color: #b91c1c; margin-bottom: 24px;">
      <strong>Notice:</strong> {fetchError}
    </div>
  )}

  {posts.length === 0 && !fetchError && (
    <div style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 60px 24px; text-align: center;">
      <h3 style="font-size: 18px; font-weight: 600; margin: 0 0 8px 0;">No articles published yet</h3>
      <p style="color: #71717a; margin: 0 0 20px 0; font-size: 14px;">
        Head over to the admin dashboard to create and publish your first article.
      </p>
      <a href="http://localhost:5173/new" class="btn-primary-pill" target="_blank">
        Create Article in Admin ↗
      </a>
    </div>
  )}

  <div style="display: flex; flex-direction: column; gap: 14px;">
    {posts.map((post) => (
      <a href={`/posts/${post.slug}`} class="post-card" style="display: flex; gap: 20px; align-items: center; text-decoration: none;">
        {post.cover_image ? (
          <img
            src={post.cover_image}
            alt={post.title}
            style="width: 76px; height: 76px; border-radius: 8px; object-fit: cover; background: #f4f4f5; border: 1px solid #e4e4e7; flex-shrink: 0;"
          />
        ) : (
          <div style="width: 76px; height: 76px; border-radius: 8px; background-color: #f4f4f5; border: 1px solid #e4e4e7; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #a1a1aa; flex-shrink: 0;">
            🛍️
          </div>
        )}
        <div style="flex: 1; min-width: 0;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
            <h2 style="font-size: 18px; font-weight: 600; color: #000000; margin: 0; letter-spacing: -0.01em;">
              {post.title}
            </h2>
            <span class="pill-tag-mint" style="font-size: 10px; padding: 2px 7px;">
              Published
            </span>
          </div>
          {post.excerpt && (
            <p style="font-size: 14px; color: #71717a; margin: 0 0 6px 0; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              {post.excerpt}
            </p>
          )}
          <div style="font-size: 12px; color: #a1a1aa;">
            {new Date(post.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
          </div>
        </div>
        <div style="color: #a1a1aa; font-size: 16px; padding-right: 4px;">
          &rarr;
        </div>
      </a>
    ))}
  </div>
</Layout>
