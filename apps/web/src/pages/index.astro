---
import Layout from '../layouts/Layout.astro';
import type { Post } from '@cms/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

let posts: Post[] = [];
let fetchError = null;

try {
  const res = await fetch(`${API_BASE}/api/posts`);
  if (res.ok) {
    posts = await res.json();
  } else {
    fetchError = `API error: ${res.status} ${res.statusText}`;
  }
} catch (e: any) {
  fetchError = `Failed to connect to API worker at ${API_BASE}.`;
}
---

<Layout title="EdgeBlog — Modern Edge Publications">
  <div style="margin-bottom: 40px;">
    <h1 style="font-size: 44px; font-weight: 700; color: #141414; margin: 0 0 8px 0; letter-spacing: -0.02em;">
      Publications.
    </h1>
    <p style="font-size: 18px; color: #707070; margin: 0; font-weight: 300;">
      Articles served worldwide with sub-50ms latency from the edge.
    </p>
  </div>

  {fetchError && (
    <div style="padding: 16px 20px; border-radius: 16px; background-color: #fff5f5; border: 1px solid #fed7d7; color: #c53030; margin-bottom: 24px;">
      <strong>Notice:</strong> {fetchError}
    </div>
  )}

  {posts.length === 0 && !fetchError && (
    <div style="background-color: #f3f3f3; border-radius: 24px; padding: 60px 24px; text-align: center;">
      <h3 style="font-size: 20px; font-weight: 700; margin: 0 0 8px 0;">No articles published yet</h3>
      <p style="color: #707070; margin: 0 0 20px 0; font-size: 14px;">
        Head over to the admin dashboard to create and publish your first post.
      </p>
      <a href="http://localhost:5173/new" class="btn-primary" target="_blank">
        Create Post in Admin ↗
      </a>
    </div>
  )}

  <div style="display: flex; flex-direction: column; gap: 16px;">
    {posts.map((post) => (
      <a href={`/posts/${post.slug}`} class="post-card" style="display: flex; gap: 20px; align-items: center; text-decoration: none;">
        {post.cover_image ? (
          <img
            src={post.cover_image}
            alt={post.title}
            style="width: 80px; height: 80px; border-radius: 24%; object-fit: cover; background: #f3f3f3; border: 1px solid #e0e0e0; flex-shrink: 0;"
          />
        ) : (
          <div style="width: 80px; height: 80px; border-radius: 24%; background-color: #f3f3f3; border: 1px solid #e0e0e0; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #adadad; flex-shrink: 0;">
            📰
          </div>
        )}
        <div style="flex: 1; min-width: 0;">
          <h2 style="font-size: 20px; font-weight: 600; color: #141414; margin: 0 0 6px 0; letter-spacing: -0.01em;">
            {post.title}
          </h2>
          {post.excerpt && (
            <p style="font-size: 14px; color: #707070; margin: 0 0 8px 0; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              {post.excerpt}
            </p>
          )}
          <div style="font-size: 12px; color: #adadad; font-weight: 500;">
            {new Date(post.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
          </div>
        </div>
        <div style="color: #adadad; font-size: 18px; padding-right: 8px;">
          &rarr;
        </div>
      </a>
    ))}
  </div>
</Layout>
