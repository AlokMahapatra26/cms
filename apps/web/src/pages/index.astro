---
import Layout from '../layouts/Layout.astro';
import { getCMSContent } from '../lib/cms';

// Fetch any collection from EdgeCMS:
// const items = await getCMSContent('your-collection-slug');
---

<Layout title="My App">
  <main class="page">
    <h1>My App</h1>
    <p>Start editing <code>src/pages/index.astro</code> to build your frontend.</p>
  </main>
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 80px auto;
    padding: 0 20px;
  }

  h1 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  p {
    color: #888888;
    font-size: 15px;
    margin: 0;
  }

  code {
    background-color: #1a1a1a;
    padding: 2px 6px;
    border-radius: 4px;
    color: #ffffff;
    font-family: var(--font-mono, monospace);
  }
</style>
