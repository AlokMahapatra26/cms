---
import Layout from '../layouts/Layout.astro';
import type { Post } from '@cms/shared';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

let posts: Post[] = [];
let fetchError = null;

try {
  const res = await fetch(`${API_BASE}/api/posts`);
  if (res.ok) {
    posts = await res.json();
  } else {
    fetchError = `API error: ${res.status} ${res.statusText}`;
  }
} catch (e: any) {
  fetchError = `Failed to connect to API worker at ${API_BASE}.`;
}
---

<Layout title="EdgeStorefront — Powered by Cloudflare D1 & R2">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 32px; font-weight: 600; color: var(--color-ink); margin: 0 0 6px 0; letter-spacing: -1.28px; line-height: 1.25;">
      Publications
    </h1>
    <p style="font-size: 14px; color: var(--color-mute); margin: 0; font-weight: 400;">
      Articles and updates distributed worldwide with sub-50ms latency from Cloudflare edge.
    </p>
  </div>

  {fetchError && (
    <div style="padding: 12px 16px; border-radius: 6px; background-color: #fff0f0; border: 1px solid #ffd6d6; color: #ee0000; margin-bottom: 24px; font-size: 13px;">
      <strong>Notice:</strong> {fetchError}
    </div>
  )}

  {posts.length === 0 && !fetchError && (
    <div style="background-color: #ffffff; border: 1px solid var(--color-hairline); border-radius: 12px; padding: 64px 24px; text-align: center;">
      <h3 style="font-size: 16px; font-weight: 600; margin: 0 0 6px 0; color: var(--color-ink);">No articles published yet</h3>
      <p style="color: var(--color-mute); margin: 0 0 20px 0; font-size: 13px;">
        Head over to the admin dashboard to create and publish your first article.
      </p>
      <a href="http://localhost:5173" class="btn-app" target="_blank">
        Create Article in Admin &nearr;
      </a>
    </div>
  )}

  <div style="display: flex; flex-direction: column; gap: 12px;">
    {posts.map((post) => (
      <a href={`/posts/${post.slug}`} class="post-card" style="display: flex; gap: 18px; align-items: center; text-decoration: none;">
        {post.cover_image ? (
          <img
            src={post.cover_image}
            alt={post.title}
            style="width: 72px; height: 72px; border-radius: 6px; object-fit: cover; background: var(--color-hairline-soft); border: 1px solid var(--color-hairline); flex-shrink: 0;"
          />
        ) : (
          <div style="width: 72px; height: 72px; border-radius: 6px; background-color: var(--color-hairline-soft); border: 1px solid var(--color-hairline); display: flex; align-items: center; justify-content: center; color: var(--color-mute); flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
        )}
        <div style="flex: 1; min-width: 0;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <h2 style="font-size: 16px; font-weight: 600; color: var(--color-ink); margin: 0; letter-spacing: -0.28px;">
              {post.title}
            </h2>
            <span class="badge-published">
              PUBLISHED
            </span>
          </div>
          {post.excerpt && (
            <p style="font-size: 13px; color: var(--color-body); margin: 0 0 6px 0; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              {post.excerpt}
            </p>
          )}
          <div style="font-size: 11px; color: var(--color-mute); font-family: var(--font-mono);">
            {new Date(post.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
          </div>
        </div>
        <div style="color: var(--color-faint); font-size: 15px; padding-right: 4px;">
          &rarr;
        </div>
      </a>
    ))}
  </div>
</Layout>
