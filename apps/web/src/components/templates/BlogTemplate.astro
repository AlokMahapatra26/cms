---
import { getCMSContent } from '../../lib/cms';

const cmsArticles = await getCMSContent('blogs');

const defaultArticles = [
  {
    id: '1',
    title: 'Architecting a Zero-Cost Headless CMS on Cloudflare D1 & R2',
    slug: 'architecting-zero-cost-headless-cms',
    excerpt: 'How we replaced expensive \$300/mo CMS stacks with Cloudflare edge compute, sub-millisecond SQLite reads, and global asset distribution.',
    category: 'Architecture',
    readTime: '4 min read',
    date: 'Nov 9, 2026',
    author: { name: 'Alok Mahapatra', role: 'Staff Architect', avatar: 'A' },
    cover: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&auto=format&fit=crop&q=80'
  },
  {
    id: '2',
    title: 'Why Static Site Generation (SSG) Beats Server-Side Rendering in 2026',
    slug: 'why-ssg-beats-ssr-2026',
    excerpt: 'Exploring the resurgence of Jamstack builds, instant webhook deployment pipelines, and why page speed directly correlates with client conversions.',
    category: 'Jamstack',
    readTime: '6 min read',
    date: 'Nov 8, 2026',
    author: { name: 'Sarah Lin', role: 'Lead Developer', avatar: 'S' },
    cover: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&auto=format&fit=crop&q=80'
  },
  {
    id: '3',
    title: 'Building Client-Proof Workspaces with Edge RBAC & Multi-Tenancy',
    slug: 'building-client-proof-workspaces',
    excerpt: 'A blueprint for agency owners to host 50+ clients under a single high-availability instance without noisy neighbor issues.',
    category: 'Engineering',
    readTime: '5 min read',
    date: 'Nov 7, 2026',
    author: { name: 'Elena Rostova', role: 'DevOps Lead', avatar: 'E' },
    cover: 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=800&auto=format&fit=crop&q=80'
  }
];

// Merge CMS items if any exist
const articles = cmsArticles.length > 0
  ? cmsArticles.map((item, idx) => ({
      id: item.id,
      title: item.data?.title || `Article #${idx + 1}`,
      slug: item.data?.slug || item.id,
      excerpt: item.data?.description || item.data?.excerpt || 'Published directly from EdgeCMS dynamic collections.',
      category: item.data?.category || 'Editorial',
      readTime: '3 min read',
      date: new Date(item.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }),
      author: { name: 'Editor', role: 'Author', avatar: 'E' },
      cover: item.data?.cover_image || defaultArticles[idx % defaultArticles.length].cover
    }))
  : defaultArticles;

const featured = articles[0];
const recent = articles.slice(1);
---

<div class="blog-template">
  <!-- Blog Hero Section -->
  <section class="section-hero">
    <div class="container">
      <div class="flex items-center gap-2 mb-3">
        <span class="badge badge-cyan">Tech & Design Journal</span>
        <span class="text-xs text-muted">Issue 42 • Live CMS Content</span>
      </div>
      <h1 class="hero-heading">Insights on Edge Computing & Modern Jamstack.</h1>
      <p class="hero-subheading">
        Real-world engineering, performance benchmarks, and design patterns from our product engineering team.
      </p>
    </div>
  </section>

  <!-- Featured Lead Article -->
  {featured && (
    <section class="container mb-8">
      <div class="card featured-card">
        <div class="featured-media">
          <img src={featured.cover} alt={featured.title} class="featured-img" />
          <span class="badge badge-emerald featured-tag">{featured.category}</span>
        </div>
        <div class="featured-content">
          <div class="flex items-center gap-3 text-xs text-muted mb-2">
            <span>{featured.date}</span>
            <span>•</span>
            <span>{featured.readTime}</span>
          </div>
          <h2 class="featured-title">{featured.title}</h2>
          <p class="featured-excerpt">{featured.excerpt}</p>
          
          <div class="flex items-center justify-between mt-6">
            <div class="flex items-center gap-2">
              <div class="author-avatar">{featured.author.avatar}</div>
              <div>
                <div class="text-xs font-semibold text-white">{featured.author.name}</div>
                <div class="text-2xs text-muted">{featured.author.role}</div>
              </div>
            </div>
            <a href={`/blogs/${featured.slug}`} class="btn btn-secondary btn-sm">
              <span>Read Story</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Filter Category Pills -->
  <section class="container mb-6">
    <div class="flex items-center justify-between border-b border-hairline pb-4">
      <div class="flex items-center gap-2 overflow-x-auto">
        <button class="filter-pill active">All Stories</button>
        <button class="filter-pill">Architecture</button>
        <button class="filter-pill">Cloudflare</button>
        <button class="filter-pill">Jamstack</button>
        <button class="filter-pill">UI & Design</button>
      </div>
      <span class="text-xs text-muted">{articles.length} Published Articles</span>
    </div>
  </section>

  <!-- 3-Column Articles Grid -->
  <section class="container section">
    <div class="grid grid-cols-3 gap-6">
      {recent.map((art) => (
        <article class="card card-hover flex flex-col justify-between">
          <div>
            <div class="article-thumb-wrapper mb-4">
              <img src={art.cover} alt={art.title} class="article-thumb" />
              <span class="badge badge-cyan article-category-pill">{art.category}</span>
            </div>
            <div class="flex items-center gap-2 text-2xs text-muted mb-2">
              <span>{art.date}</span>
              <span>•</span>
              <span>{art.readTime}</span>
            </div>
            <h3 class="article-title">{art.title}</h3>
            <p class="article-excerpt">{art.excerpt}</p>
          </div>

          <div class="flex items-center justify-between pt-4 mt-4 border-t border-hairline">
            <div class="flex items-center gap-2">
              <div class="author-avatar-sm">{art.author.avatar}</div>
              <span class="text-xs text-muted">{art.author.name}</span>
            </div>
            <a href={`/blogs/${art.slug}`} class="text-xs font-medium text-white hover-underline">
              Read →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Newsletter Signup Card -->
  <section class="container mb-12">
    <div class="card newsletter-card">
      <div class="newsletter-left">
        <span class="badge badge-purple mb-2">Weekly Dispatch</span>
        <h3 class="text-xl font-bold mb-2">Stay ahead of the edge stack.</h3>
        <p class="text-sm text-secondary m-0">Zero spam. Curated edge architecture and performance blueprints every Tuesday.</p>
      </div>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed to EdgeCMS Dispatch!');">
        <input type="email" placeholder="you@company.com" required class="newsletter-input" />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>
</div>

<style>
  .hero-heading {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 12px;
    max-width: 800px;
  }

  .hero-subheading {
    font-size: 17px;
    color: var(--text-secondary);
    max-width: 650px;
    line-height: 1.5;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    padding: 24px;
    align-items: center;
  }

  .featured-media {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 320px;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .featured-card:hover .featured-img {
    transform: scale(1.02);
  }

  .featured-tag {
    position: absolute;
    top: 14px;
    left: 14px;
  }

  .featured-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .featured-excerpt {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .border-hairline {
    border-color: var(--border-hairline);
  }

  .filter-pill {
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .filter-pill.active {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border-color: var(--border-hairline);
  }

  .article-thumb-wrapper {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 180px;
  }

  .article-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-category-pill {
    position: absolute;
    bottom: 10px;
    left: 10px;
  }

  .article-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .article-excerpt {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-hover);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .author-avatar-sm {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .text-2xs { font-size: 11px; }

  .newsletter-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 36px;
    background: linear-gradient(180deg, #111111 0%, #080808 100%);
  }

  .newsletter-form {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 420px;
  }

  .newsletter-input {
    flex: 1;
    padding: 10px 14px;
    font-size: 13px;
    color: #ffffff;
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    outline: none;
  }

  .newsletter-input:focus {
    border-color: var(--border-active);
  }

  @media (max-width: 850px) {
    .featured-card { grid-template-columns: 1fr; }
    .newsletter-card { flex-direction: column; align-items: flex-start; }
    .newsletter-form { max-width: 100%; }
  }
</style>
