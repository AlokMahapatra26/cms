---
const services = [
  { name: 'Comprehensive Oral Exam & 3D Imaging', time: '45 mins', price: '$95', desc: 'Digital low-radiation diagnostic scan, periodontal evaluation, and oral cancer screening.' },
  { name: 'Ultrasonic Deep Prophylaxis Cleaning', time: '60 mins', price: '$140', desc: 'Advanced airflow stain removal and enamel remineralization therapy.' },
  { name: 'Same-Day Ceramic Crown Restoration', time: '90 mins', price: '$850', desc: 'Precision 3D milled ceramic crowns with zero temporary molds or second visits.' },
  { name: 'Laser Teeth Whitening Therapy', time: '45 mins', price: '$290', desc: 'Medical-grade peroxide activation yielding 6-8 shades lighter in one appointment.' }
];

const team = [
  { name: 'Dr. Sarah Jenkins, DDS', role: 'Lead Prosthodontist', edu: 'Harvard School of Dental Medicine', img: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=600&auto=format&fit=crop&q=80' },
  { name: 'Dr. Marcus Vance, MD', role: 'Oral & Maxillofacial Surgeon', edu: 'Stanford Medicine', img: 'https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=600&auto=format&fit=crop&q=80' },
  { name: 'Elena Zhou, RDH', role: 'Chief Dental Hygienist', edu: 'UCSF School of Dentistry', img: 'https://images.unsplash.com/photo-1594824813511-d14cf3ec3937?w=600&auto=format&fit=crop&q=80' }
];
---

<div class="local-template">
  <!-- Top Utility Bar -->
  <div class="local-utility-bar">
    <div class="container flex justify-between items-center text-xs">
      <div class="flex items-center gap-2">
        <span class="status-dot-active"></span>
        <span class="text-white font-medium">Open Today until 8:00 PM</span>
        <span class="text-muted">•</span>
        <span class="text-muted">108 Market St, Suite 400, San Francisco</span>
      </div>
      <div class="flex items-center gap-4 text-muted">
        <span>Emergency: (415) 890-2341</span>
      </div>
    </div>
  </div>

  <!-- Local Business Hero -->
  <section class="section-hero container">
    <div class="grid grid-cols-2 gap-8 items-center">
      <div>
        <span class="badge badge-emerald mb-3">Modern Medical Care</span>
        <h1 class="local-hero-title">Elevating Dental Health with Precision Care.</h1>
        <p class="local-hero-desc">
          Experience stress-free dentistry backed by advanced 3D scanning, pain-free laser technology, and a dedicated team of board-certified clinicians.
        </p>

        <div class="flex items-center gap-3 mt-6">
          <button class="btn btn-primary" onclick="alert('Appointment scheduler opening!');">
            Book Appointment Online
          </button>
          <a href="#services" class="btn btn-secondary">
            View Treatments & Fees
          </a>
        </div>

        <div class="flex items-center gap-4 mt-8 pt-6 border-t border-hairline">
          <div class="rating-box">
            <span class="text-amber font-bold text-sm">★ 4.9 / 5.0</span>
            <span class="text-2xs text-muted">Over 450 Verified Reviews</span>
          </div>
          <span class="text-muted text-xs">•</span>
          <span class="text-xs text-muted">In-Network with Most Major Insurances</span>
        </div>
      </div>

      <div class="local-hero-media">
        <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&auto=format&fit=crop&q=80" alt="Clinic Space" class="clinic-img" />
      </div>
    </div>
  </section>

  <!-- Services & Treatments List -->
  <section id="services" class="section container">
    <div class="flex justify-between items-center mb-8">
      <div>
        <span class="badge badge-cyan mb-2">Our Care Menu</span>
        <h2 class="text-2xl font-bold text-white">Popular Treatments & Transparent Pricing</h2>
      </div>
      <span class="text-xs text-muted">Transparent Fees • No Hidden Surcharges</span>
    </div>

    <div class="grid grid-cols-2 gap-6">
      {services.map((s) => (
        <div class="card card-hover flex flex-col justify-between p-6">
          <div>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-base font-bold text-white">{s.name}</h3>
              <span class="service-price">{s.price}</span>
            </div>
            <p class="text-xs text-secondary leading-relaxed mb-4">{s.desc}</p>
          </div>
          <div class="flex justify-between items-center pt-3 border-t border-hairline text-2xs text-muted">
            <span>Duration: {s.time}</span>
            <button class="text-white font-medium hover-underline" onclick="alert('Selected service for booking!');">
              Select & Book →
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Doctor & Specialist Profiles -->
  <section class="section container">
    <div class="text-center mb-10">
      <span class="badge badge-purple mb-2">Clinical Faculty</span>
      <h2 class="text-3xl font-bold text-white mb-2">Meet Your Dedicated Specialists</h2>
      <p class="text-sm text-secondary">Decades of combined clinical excellence from premier medical universities.</p>
    </div>

    <div class="grid grid-cols-3 gap-6">
      {team.map((m) => (
        <div class="card card-hover team-card">
          <div class="team-media mb-3">
            <img src={m.img} alt={m.name} class="team-img" />
          </div>
          <h3 class="text-sm font-bold text-white">{m.name}</h3>
          <div class="text-xs text-emerald font-medium mb-1">{m.role}</div>
          <div class="text-2xs text-muted">{m.edu}</div>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .local-utility-bar {
    background: #0a0a0a;
    border-bottom: 1px solid var(--border-hairline);
    padding: 8px 0;
  }

  .status-dot-active {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    display: inline-block;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .local-hero-title {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .local-hero-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .local-hero-media {
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 380px;
    border: 1px solid var(--border-hairline);
  }

  .clinic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-price {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-mono);
  }

  .border-hairline { border-color: var(--border-hairline); }

  .team-card {
    text-align: center;
    padding: 20px;
  }

  .team-media {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto 12px;
    border: 2px solid var(--border-subtle);
  }

  .team-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text-emerald { color: #10b981; }
  .text-amber { color: #f59e0b; }
  .text-2xs { font-size: 11px; }

  @media (max-width: 850px) {
    .local-hero-title { font-size: 32px; }
  }
</style>
