---
import { getCMSContent } from '../../lib/cms';

const cmsProducts = await getCMSContent('products');

const defaultProducts = [
  {
    id: 'p1',
    name: 'Aero Minimalist Runner',
    category: 'Footwear',
    price: '$180.00',
    badge: 'Best Seller',
    badgeType: 'emerald',
    rating: 4.9,
    reviews: 128,
    image: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=700&auto=format&fit=crop&q=80'
  },
  {
    id: 'p2',
    name: 'Precision Chronograph Watch',
    category: 'Accessories',
    price: '$340.00',
    badge: 'Limited Drop',
    badgeType: 'purple',
    rating: 5.0,
    reviews: 64,
    image: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=700&auto=format&fit=crop&q=80'
  },
  {
    id: 'p3',
    name: 'Studio Wireless Headphones',
    category: 'Audio',
    price: '$260.00',
    badge: 'New Release',
    badgeType: 'cyan',
    rating: 4.8,
    reviews: 210,
    image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=700&auto=format&fit=crop&q=80'
  },
  {
    id: 'p4',
    name: 'Heavyweight Raw Denim Jacket',
    category: 'Apparel',
    price: '$220.00',
    badge: 'Low Stock',
    badgeType: 'amber',
    rating: 4.7,
    reviews: 89,
    image: 'https://images.unsplash.com/photo-1551028719-00167b16eac5?w=700&auto=format&fit=crop&q=80'
  }
];

const products = cmsProducts.length > 0
  ? cmsProducts.map((p, idx) => ({
      id: p.id,
      name: p.data?.name || p.data?.title || `Product #${idx + 1}`,
      category: p.data?.category || 'Collection',
      price: p.data?.price ? `$${p.data.price}` : '$150.00',
      badge: p.data?.badge || 'New Drop',
      badgeType: 'emerald',
      rating: 4.9,
      reviews: 42,
      image: p.data?.image || p.data?.cover_image || defaultProducts[idx % defaultProducts.length].image
    }))
  : defaultProducts;
---

<div class="ecommerce-template">
  <!-- Announcement Header -->
  <div class="ecom-banner">
    <span>Free global express delivery on all orders over $150. Use code <strong>EDGECMS</strong></span>
  </div>

  <!-- Hero Banner -->
  <section class="ecom-hero">
    <div class="container flex justify-between items-center ecom-hero-inner">
      <div class="ecom-hero-text">
        <span class="badge badge-cyan mb-3">Fall / Winter 2026</span>
        <h1 class="ecom-title">Pure Form. Uncompromising Utility.</h1>
        <p class="ecom-desc">
          Engineered essentials crafted with zero compromises. Sourced from sustainable mills and precision-assembled for everyday performance.
        </p>
        <div class="flex items-center gap-3 mt-6">
          <a href="#catalog" class="btn btn-primary">Shop All Essentials</a>
          <button class="btn btn-secondary">Explore Lookbook</button>
        </div>
      </div>
      <div class="ecom-hero-media">
        <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&auto=format&fit=crop&q=80" alt="Hero Showcase" class="hero-cover-img" />
      </div>
    </div>
  </section>

  <!-- Value Perks Strip -->
  <div class="perks-strip">
    <div class="container flex justify-between items-center perks-inner">
      <div class="perk-item">
        <span class="perk-icon">⚡</span>
        <div>
          <div class="text-xs font-semibold text-white">Instant Fulfillment</div>
          <div class="text-2xs text-muted">Dispatches within 24 hours</div>
        </div>
      </div>
      <div class="perk-item">
        <span class="perk-icon">🛡️</span>
        <div>
          <div class="text-xs font-semibold text-white">Lifetime Guarantee</div>
          <div class="text-2xs text-muted">Free repairs and warranty</div>
        </div>
      </div>
      <div class="perk-item">
        <span class="perk-icon">🔄</span>
        <div>
          <div class="text-xs font-semibold text-white">30-Day Free Returns</div>
          <div class="text-2xs text-muted">No questions asked policy</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Catalog Grid -->
  <section id="catalog" class="section container">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h2 class="text-2xl font-bold text-white mb-1">Featured Goods</h2>
        <p class="text-xs text-secondary m-0">Synchronized live from EdgeCMS Products collection.</p>
      </div>
      <div class="flex items-center gap-2">
        <button class="filter-pill active">All ({products.length})</button>
        <button class="filter-pill">Footwear</button>
        <button class="filter-pill">Apparel</button>
        <button class="filter-pill">Accessories</button>
      </div>
    </div>

    <div class="grid grid-cols-4 gap-6">
      {products.map((item) => (
        <div class="card card-hover flex flex-col justify-between ecom-product-card">
          <div>
            <div class="product-media mb-3">
              <img src={item.image} alt={item.name} class="product-img" />
              <span class={`badge badge-${item.badgeType} product-badge`}>{item.badge}</span>
            </div>
            <div class="text-2xs text-muted uppercase tracking-wider mb-1 font-mono">{item.category}</div>
            <h3 class="product-name">{item.name}</h3>
            <div class="flex items-center gap-1 my-1">
              <span class="text-xs text-amber font-medium">★ {item.rating}</span>
              <span class="text-2xs text-muted">({item.reviews})</span>
            </div>
          </div>

          <div class="flex items-center justify-between mt-4 pt-3 border-t border-hairline">
            <span class="product-price">{item.price}</span>
            <button
              class="btn btn-secondary btn-sm"
              onclick={`alert('Added ${item.name} to Cart!');`}
            >
              Add to Bag
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .ecom-banner {
    background: #111111;
    border-bottom: 1px solid var(--border-hairline);
    text-align: center;
    padding: 8px 16px;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .ecom-hero {
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--border-hairline);
    background: radial-gradient(circle at 20% 20%, #151515 0%, #000000 70%);
  }

  .ecom-hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .ecom-title {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-bottom: 16px;
    color: #ffffff;
  }

  .ecom-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 520px;
  }

  .ecom-hero-media {
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 380px;
    border: 1px solid var(--border-hairline);
  }

  .hero-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .perks-strip {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-hairline);
    padding: 18px 0;
  }

  .perks-inner {
    display: flex;
    justify-content: space-around;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .perk-icon {
    font-size: 20px;
  }

  .product-media {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 220px;
    background: #0d0d0d;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ecom-product-card:hover .product-img {
    transform: scale(1.04);
  }

  .product-badge {
    position: absolute;
    top: 10px;
    left: 10px;
  }

  .product-name {
    font-size: 14.5px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
  }

  .product-price {
    font-size: 15px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: #ffffff;
  }

  .border-hairline {
    border-color: var(--border-hairline);
  }

  .text-2xs { font-size: 11px; }

  @media (max-width: 900px) {
    .ecom-hero-inner { grid-template-columns: 1fr; }
    .perks-inner { flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
