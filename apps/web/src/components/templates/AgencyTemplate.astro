---
const caseStudies = [
  {
    title: 'FinScale Protocol',
    category: 'Fintech & Web3',
    stat: '+340% User Growth',
    image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&auto=format&fit=crop&q=80',
    desc: 'High-frequency algorithmic trading dashboard built on Cloudflare Workers edge compute.'
  },
  {
    title: 'Lumina Audio Space',
    category: 'Hardware & E-Commerce',
    stat: '$2.8M Launch Day',
    image: 'https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=800&auto=format&fit=crop&q=80',
    desc: 'Interactive 3D product showcase and sub-second checkout engine powered by Astro.'
  },
  {
    title: 'Cerebral AI Assistant',
    category: 'Machine Learning',
    stat: '100/100 Lighthouse',
    image: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&auto=format&fit=crop&q=80',
    desc: 'Full-stack brand strategy, design system, and multi-tenant headless CMS deployment.'
  }
];

const capabilities = [
  { num: '01', title: 'Product Architecture', desc: 'Designing resilient distributed backends with Cloudflare D1, R2, and serverless edge functions.' },
  { num: '02', title: 'Design Systems', desc: 'Crafting pixel-perfect design systems, micro-interactions, and accessible typography.' },
  { num: '03', title: 'Headless CMS Integration', desc: 'Equipping marketing teams with custom visual content workflows and zero-maintenance schemas.' },
  { num: '04', title: 'Performance Optimization', desc: 'Achieving sub-second First Contentful Paint (FCP) and 100/100 Core Web Vitals across all viewports.' }
];
---

<div class="agency-template">
  <!-- Agency Hero -->
  <section class="section-hero container">
    <span class="badge badge-purple mb-4">Autonomous Creative Engineering</span>
    <h1 class="agency-hero-title">
      We build digital products that define tomorrow's market leaders.
    </h1>
    <p class="agency-hero-desc">
      A studio of architects, engineers, and product designers partnering with venture-backed startups and ambitious global brands.
    </p>

    <!-- Stats Bar -->
    <div class="grid grid-cols-3 gap-6 mt-12 py-6 border-t border-b border-hairline">
      <div>
        <div class="stat-number">50+</div>
        <div class="text-xs text-muted">Shipped Edge Applications</div>
      </div>
      <div>
        <div class="stat-number">$40M+</div>
        <div class="text-xs text-muted">Client Revenue Powered</div>
      </div>
      <div>
        <div class="stat-number">0ms</div>
        <div class="text-xs text-muted">Cold Starts on Cloudflare</div>
      </div>
    </div>
  </section>

  <!-- Selected Works -->
  <section class="section container">
    <div class="flex justify-between items-center mb-8">
      <div>
        <span class="badge badge-cyan mb-2">Portfolio</span>
        <h2 class="text-2xl font-bold text-white">Selected Works</h2>
      </div>
      <a href="#contact" class="btn btn-secondary btn-sm">Explore All Archives →</a>
    </div>

    <div class="grid grid-cols-3 gap-6">
      {caseStudies.map((study) => (
        <div class="card card-hover flex flex-col justify-between work-card">
          <div>
            <div class="work-media mb-4">
              <img src={study.image} alt={study.title} class="work-img" />
              <span class="badge badge-emerald work-stat-pill">{study.stat}</span>
            </div>
            <span class="text-2xs text-muted font-mono uppercase">{study.category}</span>
            <h3 class="text-lg font-bold text-white mt-1 mb-2">{study.title}</h3>
            <p class="text-xs text-secondary leading-relaxed">{study.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between">
            <span class="text-xs font-semibold text-white">View Case Study</span>
            <span>↗</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Capabilities Matrix -->
  <section class="section container">
    <div class="text-center mb-10">
      <span class="badge badge-emerald mb-2">Capabilities</span>
      <h2 class="text-3xl font-bold text-white mb-2">Full-Lifecycle Product Execution</h2>
      <p class="text-sm text-secondary">From first concept sketch to global multi-region production rollout.</p>
    </div>

    <div class="grid grid-cols-2 gap-6">
      {capabilities.map((c) => (
        <div class="card card-hover flex gap-4 p-6">
          <span class="capability-num">{c.num}</span>
          <div>
            <h3 class="text-base font-bold text-white mb-2">{c.title}</h3>
            <p class="text-xs text-secondary leading-relaxed m-0">{c.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact CTA Banner -->
  <section id="contact" class="container section">
    <div class="card agency-contact-card">
      <div class="max-w-xl">
        <span class="badge badge-amber mb-3">Available for Q1 2027</span>
        <h2 class="text-3xl font-bold text-white mb-3">Have an ambitious project in mind?</h2>
        <p class="text-sm text-secondary mb-6">Let's connect and build a high-performance web platform tailored for your market.</p>
        <button class="btn btn-primary" onclick="alert('Contact inquiry launched!');">
          Start a Conversation →
        </button>
      </div>
    </div>
  </section>
</div>

<style>
  .agency-hero-title {
    font-size: 50px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: #ffffff;
    max-width: 900px;
    margin-bottom: 20px;
  }

  .agency-hero-desc {
    font-size: 18px;
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.6;
  }

  .stat-number {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    font-family: var(--font-mono);
  }

  .border-hairline { border-color: var(--border-hairline); }

  .work-media {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 200px;
  }

  .work-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-card:hover .work-img {
    transform: scale(1.03);
  }

  .work-stat-pill {
    position: absolute;
    top: 10px;
    right: 10px;
  }

  .capability-num {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent-purple);
    font-weight: 700;
  }

  .agency-contact-card {
    padding: 48px;
    background: radial-gradient(circle at 100% 0%, #1c1033 0%, #0a0a0a 70%);
    border-color: #3b2865;
  }

  .max-w-xl { max-width: 580px; }
  .text-2xs { font-size: 11px; }

  @media (max-width: 850px) {
    .agency-hero-title { font-size: 34px; }
  }
</style>
