---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        color: #141414;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .nav-pill {
        background-color: #f3f3f3;
        border-radius: 9999px;
        padding: 8px 14px 8px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 860px;
        margin: 24px auto 40px auto;
      }
      .btn-primary {
        background-color: #141414;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        border-radius: 9999px;
        padding: 8px 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .btn-outline {
        background-color: #ffffff;
        color: #141414;
        border: 1px solid #e0e0e0;
        border-radius: 9999px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
      }
      .post-card {
        background-color: #ffffff;
        border: 1px solid #f0f0f0;
        border-radius: 20px;
        padding: 24px;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }
      .post-card:hover {
        border-color: #e0e0e0;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body style="min-height: 100vh; display: flex; flex-direction: column;">
    <!-- Floating Nav Pill -->
    <header style="padding: 0 16px;">
      <nav class="nav-pill">
        <a href="/" style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 32px; height: 32px; background: #141414; border-radius: 30%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 700;">
            E
          </div>
          <span style="font-size: 17px; font-weight: 700; color: #141414; letter-spacing: -0.01em;">EdgeBlog.</span>
        </a>

        <div style="display: flex; align-items: center; gap: 12px;">
          <a href="http://localhost:5173" class="btn-primary" target="_blank">
            Admin CMS ↗
          </a>
        </div>
      </nav>
    </header>

    <main style="max-width: 860px; width: 100%; margin: 0 auto; padding: 0 16px 80px 16px; flex: 1;">
      <slot />
    </main>

    <footer style="background-color: #141414; color: #ffffff; border-top-left-radius: 24px; border-top-right-radius: 24px; padding: 48px 32px 36px 32px; margin-top: auto;">
      <div style="max-width: 860px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
          <span style="font-weight: 700; font-size: 16px;">EdgeBlog.</span>
          <p style="color: #adadad; font-size: 13px; margin: 4px 0 0 0;">
            Static front powered by Astro + Hono + Cloudflare D1 & R2.
          </p>
        </div>
        <div style="font-size: 13px; color: #adadad;">
          Design inspired by Mobbin
        </div>
      </div>
    </footer>
  </body>
</html>
