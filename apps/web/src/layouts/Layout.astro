---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body style="max-width: 800px; margin: 30px auto; padding: 0 16px; font-family: monospace; line-height: 1.6;">
    <header>
      <h1><a href="/" style="text-decoration: none; color: inherit;">// Public Edge Blog</a></h1>
      <p style="color: #666; margin-top: -10px;">
        Powered by Astro + Hono + Cloudflare D1 & R2 | <a href="http://localhost:5173" target="_blank">[Admin CMS Dashboard]</a>
      </p>
    </header>
    <hr style="border: none; border-top: 1px solid #ccc; margin: 20px 0;" />
    
    <main>
      <slot />
    </main>

    <footer style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #eee; color: #888; font-size: 12px;">
      <p>Bare minimum static website frontend</p>
    </footer>
  </body>
</html>

