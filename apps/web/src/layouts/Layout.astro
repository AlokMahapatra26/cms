---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --color-primary: #000000;
        --color-canvas-cream: #fbfbf5;
        --color-aloe: #c1fbd4;
        --color-hairline: #e4e4e7;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: var(--color-canvas-cream);
        color: #000000;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-feature-settings: "ss03";
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .shopify-header {
        background-color: #ffffff;
        border-bottom: 1px solid var(--color-hairline);
        padding: 14px 24px;
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .btn-primary-pill {
        background-color: #000000;
        color: #ffffff;
        font-size: 13px;
        font-weight: 500;
        border-radius: 9999px;
        padding: 8px 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .btn-outline-pill {
        background-color: #ffffff;
        color: #000000;
        border: 1px solid #d4d4d8;
        border-radius: 9999px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
      }
      .post-card {
        background-color: #ffffff;
        border: 1px solid var(--color-hairline);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -2px rgba(0, 0, 0, 0.02);
        transition: all 0.15s ease;
      }
      .post-card:hover {
        border-color: #a1a1aa;
        transform: translateY(-2px);
      }
      .pill-tag-mint {
        background-color: var(--color-aloe);
        color: #000000;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
      }
    </style>
  </head>
  <body style="min-height: 100vh; display: flex; flex-direction: column;">
    <!-- Shopify Storefront Header -->
    <header class="shopify-header">
      <div style="max-width: 960px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between;">
        <a href="/" style="display: flex; align-items: center; gap: 10px;">
          <svg width="26" height="26" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="28" height="28" rx="8" fill="#000000" />
            <path d="M14 6C12.3431 6 11 7.34315 11 9H9C8.44772 9 8 9.44772 8 10V20C8 20.5523 8.44772 21 9 21H19C19.5523 21 20 20.5523 20 20V10C20 9.44772 19.5523 9 19 9H17C17 7.34315 15.6569 6 14 6ZM14 7.5C14.8284 7.5 15.5 8.17157 15.5 9H12.5C12.5 8.17157 13.1716 7.5 14 7.5ZM9.5 10.5H18.5V19.5H9.5V10.5Z" fill="#C1FBD4" />
          </svg>
          <span style="font-size: 16px; font-weight: 600; color: #000000; letter-spacing: -0.01em;">EdgeStorefront</span>
        </a>

        <div style="display: flex; align-items: center; gap: 10px;">
          <a href="http://localhost:5173" class="btn-primary-pill" target="_blank">
            Admin CMS ↗
          </a>
        </div>
      </div>
    </header>

    <main style="max-width: 960px; width: 100%; margin: 36px auto 80px auto; padding: 0 20px; flex: 1;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="background-color: #ffffff; border-top: 1px solid #e4e4e7; padding: 36px 24px; margin-top: auto;">
      <div style="max-width: 960px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
          <span style="font-weight: 600; font-size: 14px;">EdgeStorefront</span>
          <p style="color: #71717a; font-size: 13px; margin: 4px 0 0 0;">
            Static front powered by Astro + Hono + Cloudflare D1 & R2.
          </p>
        </div>
        <div style="font-size: 13px; color: #71717a;">
          Design inspired by Shopify
        </div>
      </div>
    </footer>
  </body>
</html>
