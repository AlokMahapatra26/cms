---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "EdgeCMS — Blank Canvas Starter",
  description = "A clean, minimal Astro 5.0 starter powered by EdgeCMS."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <!-- Minimalist Header -->
    <header class="app-header">
      <div class="container flex justify-between items-center header-inner">
        <a href="/" class="brand">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="24" height="24" rx="5" fill="#ffffff" />
            <path d="M7 12H17M7 7H17M7 17H13" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span class="brand-title">EdgeCMS</span>
          <span class="badge badge-subtle">Starter</span>
        </a>

        <div class="flex items-center gap-3">
          <a
            href="http://localhost:5173"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm"
          >
            <span>CMS Studio</span>
            <svg width="11" height="11" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0L12 9.06V13a.75.75 0 0 0 1.5 0V7.25a.75.75 0 0 0-.75-.75H7a.75.75 0 0 0 0 1.5h3.94l-5.72 5.72a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Main View -->
    <main>
      <slot />
    </main>

    <!-- Minimalist Footer -->
    <footer class="app-footer">
      <div class="container flex justify-between items-center footer-inner">
        <span class="text-xs text-muted">EdgeCMS + Astro 5.0 • Blank Developer Canvas</span>
        <div class="flex items-center gap-4 text-xs text-muted">
          <a href="http://localhost:5173" target="_blank" class="hover-white">CMS Admin</a>
          <a href="http://localhost:8787/api/posts" target="_blank" class="hover-white">API Docs</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .app-header {
    border-bottom: 1px solid var(--border-hairline);
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    height: 56px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .badge-subtle {
    font-size: 10px;
    font-weight: 500;
    background: var(--bg-hover);
    color: var(--text-muted);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-hairline);
  }

  .app-footer {
    border-top: 1px solid var(--border-hairline);
    padding: 24px 0;
    margin-top: 80px;
  }

  .hover-white:hover {
    color: #ffffff;
  }
</style>
