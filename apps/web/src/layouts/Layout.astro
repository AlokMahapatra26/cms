---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "EdgeCMS Web",
  description = "Astro frontend powered by EdgeCMS"
} = Astro.props;

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="app-nav">
      <div class="nav-inner">
        <a href="/" class="nav-brand">
          <span class="brand-dot"></span>
          <span class="brand-text">EdgeCMS Web</span>
        </a>
        <nav class="nav-links">
          {isDev && (
            <a href="http://localhost:5173" target="_blank" rel="noopener noreferrer" class="studio-link" title="Open EdgeCMS Admin Studio">
              <span>Studio</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          )}
        </nav>
      </div>
    </header>

    <div class="page-content">
      <slot />
    </div>

    <footer class="app-footer">
      <div class="footer-inner">
        <span>Powered by EdgeCMS & Astro</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .app-nav {
    border-bottom: 1px solid #1a1a1a;
    background-color: #000000;
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .nav-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
  }

  .brand-text {
    color: #ffffff;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .studio-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 500;
    color: #d1d5db;
    background-color: #111111;
    border: 1px solid #262626;
    padding: 3px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .studio-link:hover {
    background-color: #1a1a1a;
    border-color: #3b3b3b;
    color: #ffffff;
  }

  .page-content {
    min-height: calc(100vh - 120px);
  }

  .app-footer {
    border-top: 1px solid #141414;
    padding: 24px 20px;
  }

  .footer-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #52525b;
  }
</style>
