{
  "name": "edge-cms-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cms/api --filter @cms/admin --parallel dev",
    "dev:cms": "pnpm --filter @cms/api --filter @cms/admin --parallel dev",
    "dev:api": "pnpm --filter @cms/api dev",
    "dev:admin": "pnpm --filter @cms/admin dev",
    "build": "pnpm --filter @cms/admin build",
    "build:admin": "pnpm --filter @cms/admin build",
    "migrate:local": "pnpm --filter @cms/api migrate:local"
  }
}
