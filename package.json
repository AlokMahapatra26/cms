{
  "name": "cfedge-cms-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cms/api --filter @cms/admin --filter @cms/web --parallel dev",
    "dev:cms": "pnpm --filter @cms/api --filter @cms/admin --parallel dev",
    "dev:web": "pnpm --filter @cms/web dev",
    "dev:api": "pnpm --filter @cms/api dev",
    "dev:admin": "pnpm --filter @cms/admin dev",
    "build": "pnpm --filter @cms/admin build && pnpm --filter @cms/web build",
    "build:admin": "pnpm --filter @cms/admin build",
    "build:web": "pnpm --filter @cms/web build",
    "migrate:local": "pnpm --filter @cms/api migrate:local",
    "cms:sync": "node scripts/sync-cms.mjs",
    "deploy:api": "pnpm --filter @cms/api wrangler deploy",
    "deploy:admin": "VITE_API_BASE_URL=\"https://cms-api.alokmahapatra2604.workers.dev\" pnpm --filter @cms/admin build && pnpm --filter @cms/api wrangler pages deploy ../admin/build --project-name=edgecms-admin",
    "deploy": "pnpm deploy:api && pnpm deploy:admin"
  }
}
